# Local data directory. Keep personal data outside the Git repository.
DATA_DIR=D:/AI/resume-tailor-data

# Copy this file to backend/.env and fill the key locally when needed.
# Never prefix a secret with VITE_; Vite variables are sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional, only for clients calling the backend directly from another origin.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
